# `docker compose run --rm persona-vault-init` writes the real .env for you; this file only documents the variables.
# Never commit .env. Values are literal, so single-quote any value that contains `$`.
VAULT_REPO_SSH_URL=git@github.com:OWNER/persona-vault.git
HOST_ID=persona-vault-gateway
# 16+ characters. Do not keep this placeholder.
ADMIN_PASSWORD=<long-random-password>
# Loopback only by default. Changing the bind address is your decision: reach the port only over an encrypted
# private path or an existing TLS endpoint you operate. Never expose plain HTTP (tokens and the admin password) publicly.
GATEWAY_BIND_ADDR=127.0.0.1
GATEWAY_HOST_PORT=18080
VAULT_SYNC_INTERVAL_SECONDS=300
# Primary deployment: keyword-only search. No Cloudflare account and no Qdrant are needed.
EMBEDDING_PROVIDER=none
# Optional semantic search needs ALL of: EMBEDDING_PROVIDER=cloudflare, COMPOSE_PROFILES=semantic (starts Qdrant),
# and both Cloudflare values below. Existing installs that relied on the old cloudflare default must set these
# before upgrading. Indexed chunks and queries (including 90_Private/) are then sent to Cloudflare Workers AI.
# COMPOSE_PROFILES=semantic
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
EMBEDDING_MODEL=@cf/qwen/qwen3-embedding-0.6b
EMBEDDING_BATCH_SIZE=32
QDRANT_COLLECTION=persona_vault
