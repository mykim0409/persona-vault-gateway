# Everything here is optional: the Gateway starts with no .env at all and is set up in the browser at /setup.
# Never commit .env. Values are literal, so single-quote any value that contains `$`.
#
# Optional first-use setup code (20-200 printable ASCII characters, no spaces). If unset, the Gateway prints a
# one-time code to its log on the first start (docker compose logs persona-vault-gateway).
# PVG_SETUP_TOKEN=<long-random-value>
HOST_ID=persona-vault-gateway
# Set true only when browsers reach the Gateway over HTTPS through a proxy it does not trust (keeps admin cookies Secure).
# Do not widen FORWARDED_ALLOW_IPS for this.
PVG_SECURE_COOKIES=false
# Loopback only by default. Changing the bind address is your decision: reach the port only over an encrypted
# private path or an existing TLS endpoint you operate. Never expose plain HTTP (tokens and the admin password) publicly.
GATEWAY_BIND_ADDR=127.0.0.1
GATEWAY_HOST_PORT=18080
VAULT_SYNC_INTERVAL_SECONDS=300
# Primary deployment: keyword-only search. No Cloudflare account and no Qdrant are needed.
EMBEDDING_PROVIDER=none
# Optional semantic search needs ALL of: EMBEDDING_PROVIDER=cloudflare, COMPOSE_PROFILES=semantic (starts Qdrant),
# and both Cloudflare values below. Indexed chunks and queries (including 90_Private/) are then sent to Cloudflare
# Workers AI.
# COMPOSE_PROFILES=semantic
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
EMBEDDING_MODEL=@cf/qwen/qwen3-embedding-0.6b
EMBEDDING_BATCH_SIZE=32
QDRANT_COLLECTION=persona_vault
